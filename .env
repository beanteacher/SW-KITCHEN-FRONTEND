# 로컬 개발 기본값 (비밀값 아님). 배포 환경에서는 환경 변수로 덮어쓴다.
API_SERVER_URL=http://localhost:8080
IMAGE_BASE_URL=http://localhost:9000/sw-kitchen
# Cloudflare Turnstile 테스트용 사이트 키 (항상 통과, 화면에 드러나도 되는 값). 운영은 실제 사이트 키로 덮어쓴다
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# 포트원 본인인증 (상점 아이디·채널 키, 화면에 드러나도 되는 값). 받으면 .env.local 에 넣는다
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
